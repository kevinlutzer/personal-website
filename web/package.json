{
  "name": "personal-website-client",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "ng serve --ssl --proxy-config src/proxy/proxy.conf.local.json --port=4200",
    "start:prod": "ng serve --ssl --proxy-config src/proxy/proxy.conf.prod.json --port=4200",
    "build": "ng build --optimization --vendor-chunk --output-path=../public --stats-json",
    "lint": "ng lint",
    "bundle-report": "webpack-bundle-analyzer dist/personal-website-client/stats.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.17",
    "@angular/common": "^19.2.17",
    "@angular/compiler": "^19.2.17",
    "@angular/core": "^19.2.17",
    "@angular/forms": "^19.2.17",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.17",
    "@angular/platform-browser-dynamic": "^19.2.17",
    "@angular/router": "^19.2.17",
    "chart.js": "^4.3.0",
    "ng2-charts": "^4.1.1",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.19",
    "@angular/cli": "~19.2.19",
    "@angular/compiler-cli": "^19.2.17",
    "@types/marked": "^4.3.2",
    "angular-eslint": "19.3.0",
    "codelyzer": "^6.0.2",
    "eslint": "^9.23.0",
    "typescript": "~5.5.4",
    "typescript-eslint": "8.27.0",
    "webpack-bundle-analyzer": "^4.9.1"
  }
}